# Copy to .env on the host. Never commit real secrets.
# Vault key (document later): DISCORD_FLEET_WAKE

# Required for live Discord. Leave empty / placeholder → process exits cleanly (no Gateway login).
DISCORD_BOT_TOKEN=

# Primary guild (seeded from OpenClaw shape; still deny-by-default until token present)
DISCORD_GUILD_ID=949100784186966066

# Comma-separated Discord user IDs allowed to talk to the bridge (guild + DM after pairing)
DISCORD_ALLOWFROM=339560375924031498,354095575282614272

# Optional comma-separated role IDs (empty = no role grant path; users still required)
DISCORD_ALLOW_ROLES=

# Optional comma-separated channel IDs. Empty = rely on channel-map enabled rows only.
# If set, message channel must be in this list AND have an enabled map row.
DISCORD_ALLOW_CHANNELS=

# Owner (command / DM pairing approval). Seed: KittenClubber
DISCORD_OWNER_ID=339560375924031498

# DM policy: pairing | allowlist | disabled
DISCORD_DM_POLICY=pairing

# Grok Bot local sendPrompt endpoint (host-network reachable from container via host.docker.internal or LAN IP)
# Example when Grok Bot computer listens on :1340:
GROK_BOT_SENDPROMPT_URL=http://host.docker.internal:1340/api/sendPrompt

# Optional bearer/token for sendPrompt (if Grok Bot gateway requires it)
GROK_BOT_GATEWAY_TOKEN=

# Callback auth: Grok Bot / agents POST results back here
CALLBACK_TOKEN=change-me-before-go-live
CALLBACK_PATH=/callback
# Advertised base for agents (host loopback from Zion perspective)
CALLBACK_BASE_URL=http://127.0.0.1:18083

# HTTP bind inside container (compose maps 127.0.0.1:18083)
HTTP_BIND=0.0.0.0
HTTP_PORT=18083

# Paths (defaults match image layout)
CHANNEL_MAP_PATH=/app/config/channel-map.json
SECURITY_CONFIG_PATH=/app/config/security.json

# If true, require @bot mention in guild channels (per-guild override lives in security.json)
# Seed guild KittenClubbers uses requireMention=false in security.json
REQUIRE_MENTION_DEFAULT=true

# Set to 1 only for local dry-run without Discord (HTTP health/callback only). Default 0.
HTTP_ONLY=0
