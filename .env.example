# Copy to .env on the host. Never commit real secrets.

# Required for live Discord. Leave empty / placeholder → process exits cleanly (no Gateway login).
DISCORD_BOT_TOKEN=

# Primary guild snowflake (replace placeholder with yours; still deny-by-default until token present)
DISCORD_GUILD_ID=111111111111111111

# Comma-separated Discord user IDs allowed to talk to the bridge (guild + DM after pairing)
DISCORD_ALLOWFROM=222222222222222222,333333333333333333

# Optional comma-separated role IDs (empty = no role grant path; users still required)
DISCORD_ALLOW_ROLES=

# Optional comma-separated channel IDs. Empty = rely on channel-map enabled rows only.
# If set, message channel must be in this list AND have an enabled map row.
DISCORD_ALLOW_CHANNELS=

# Owner (command / DM pairing approval). Replace with your Discord user snowflake.
DISCORD_OWNER_ID=222222222222222222

# DM policy: pairing | allowlist | disabled
DISCORD_DM_POLICY=pairing

# Grok Bot sendPrompt endpoint.
# - Grok Bot app on the same Docker host: host.docker.internal (or the LAN IP) works, e.g.
#   http://host.docker.internal:1340/api/sendPrompt
# - Cloud Grok Bot computer: host.docker.internal will NOT work. Use its public tunnel URL,
#   e.g. https://example.com/api/sendPrompt
GROK_BOT_SENDPROMPT_URL=http://host.docker.internal:1340/api/sendPrompt

# Bearer token for sendPrompt, from your Grok Bot gateway/sendPrompt setup. Keep it in your vault.
# Required for wakes (fail-closed if blank — bridge refuses sendPrompt).
GROK_BOT_GATEWAY_TOKEN=

# Callback auth: Grok Bot / agents POST results back here
CALLBACK_TOKEN=change-me-before-go-live
# Soft POST /callback rate limit (per token hash AND per client IP). Default 90/min.
# High enough that normal dual-deliver never trips; 429 + Retry-After only on abuse. 0 = disabled.
CALLBACK_RATE_LIMIT_PER_MIN=90
CALLBACK_PATH=/callback
# Advertised base for agents (host loopback from the bridge host)
CALLBACK_BASE_URL=http://127.0.0.1:18083

# Optional. Used only when POST /voice/play sends voice=grok. Default playback is local Piper.
# grok-voice-latest is the Grok Voice 3.0 alias. Do not commit a real key.
XAI_API_KEY=

# HTTP bind inside container (compose maps 127.0.0.1:18083)
HTTP_BIND=0.0.0.0
HTTP_PORT=18083

# Paths (defaults match image layout)
CHANNEL_MAP_PATH=/app/config/channel-map.json
SECURITY_CONFIG_PATH=/app/config/security.json

# If true, require @bot mention in guild channels (per-guild override lives in security.json)
REQUIRE_MENTION_DEFAULT=true

# Set to 1 only for local dry-run without Discord (HTTP health/callback only). Default 0.
HTTP_ONLY=0

# Optional local-planner hop. Ignored unless a channel-map row sets
# primary_llm=local, wake_agent=false, local_handler=local-media-planner.
# (Older local_handler / log names are still accepted as deprecated aliases.)
# Unset = every channel stays on sendPrompt. Blank URL/token fails an opted-in row closed
# (still does not sendPrompt).
# The hop sends the inbound Discord message id and CALLBACK_BASE_URL+CALLBACK_PATH
# as messageId and callbackUrl (JSON body and query). Do not put CALLBACK_TOKEN in the query.
# When the bridge posts "Working on it.", it also sends that message id as statusMessageId.
# A listener timeout or dropped connection is not a user-facing failure.
LOCAL_PLANNER_URL=
LOCAL_PLANNER_TOKEN=

# sendPrompt hold-and-retry (0.2.10). When the Grok Bot tunnel is down (HTTP 530 /
# Cloudflare 1033, 502/503/504, network errors), the bridge holds the message and
# retries (5s, 10s, 20s, then every 30s) for up to this many seconds before the red X.
# 0 = no hold (first tunnel error is final). Auth and other 4xx always fail fast.
# Recommended: 1800 together with the wake hook below (gives the wake time to land; no upper
# cap; 3600 for slow wakes). Without a wake hook, 900 is enough.
SENDPROMPT_HOLD_MAX_SEC=1800
# JSON backup of held hops, reloaded and replayed on restart. Relative to the working
# dir (/app in the image, a named volume in compose). Set empty for memory only.
SENDPROMPT_HOLD_FILE=./data/sendprompt-hold.json

# Strongly recommended wake hook (0.2.12). Grok Bot computers sleep when idle; the hold
# (SENDPROMPT_HOLD_MAX_SEC) alone only covers short sleeps, the wake hook makes long sleeps recoverable.
# Blank URL = off. While a hop is held on a tunnel error
# (530 / 1033 / 502-504 / network), POST once per outage to this URL with only
# {"reason","heldCount","firstHeldAt"} (no tokens, no message text, no ids). Re-arms after
# the next successful sendPrompt or when nothing is held. 5s timeout; never blocks the hold.
# One URL per Grok Bot account is enough (its bots share one computer).
SENDPROMPT_WAKE_URL=
# Key from your vault. Never commit it. Blank = no auth header.
SENDPROMPT_WAKE_KEY=
# Authorization (default) sends "Authorization: Bearer <key>". Any other header name sends
# the raw key, e.g. X-Webhook-Key. Verified with the Grok Bot routine webhook:
# bearer (default) works; a good wake returns 200 {"success":true,"runUuid":"..."}.
SENDPROMPT_WAKE_HEADER=Authorization

# User directory (0.2.11): Discord user id -> username / display name / label, learned
# from inbound messages. Names and timestamps only. Empty = memory only.
USER_DIRECTORY_FILE=./data/user-directory.json
# Optional read-only seed (labels win). Copy config/user-directory.seed.example.json.
USER_DIRECTORY_SEED_FILE=./config/user-directory.seed.json

# Wake prompt shape (0.2.14). compact (default): "Discord DM from <label>: <text>" plus one
# trailing routing line "⟂ d:<slug>:<msgId> u=<id> c=<id> [g=<id>] [map=<alias>] [a=<url>]...".
# legacy: the 0.2.13 "d:<slug>:<msgId>" line + thin JSON. Rollback = legacy, then
# `docker compose up -d` (restart does not re-read .env).
WAKE_PROMPT_FORMAT=compact
